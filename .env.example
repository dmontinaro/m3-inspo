# Postgres (Railway pgvector template). Local: `docker compose up -d` (compose.yaml, host port 54330).
DATABASE_URL=postgres://postgres:postgres@localhost:54330/inspo
# Compose host port. If changed, update DATABASE_URL and the test server URL too.
POSTGRES_PORT=54330
# Test override, supplied when running tests, without a database name:
# TEST_DATABASE_SERVER_URL=postgres://postgres:postgres@localhost:54330

# Public origin, used for links in MCP answers and DESIGN.md exports.
INSPO_BASE_URL=http://localhost:3000

# Better Auth. Secret: at least 32 random characters, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of the web app; the GitHub callback is <BETTER_AUTH_URL>/api/auth/callback/github.
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app (github.com/settings/developers).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Numeric GitHub user id of the owner, the only account that may sign in.
# Look it up with `gh api user --jq .id`. Unset = nobody gets in.
OWNER_GITHUB_ID=

# Image storage. Set STORAGE_DIR for a local folder (development); relative paths start at
# apps/web, so this is the git-ignored .storage at the repo root. Leave it unset in production.
STORAGE_DIR=../../.storage
# Otherwise the S3-compatible Railway bucket. On Railway use references to the bucket service:
# S3_BUCKET=${{bucket.BUCKET}}, S3_ENDPOINT=${{bucket.ENDPOINT}}, S3_REGION=${{bucket.REGION}},
# S3_ACCESS_KEY_ID=${{bucket.ACCESS_KEY_ID}}, S3_SECRET_ACCESS_KEY=${{bucket.SECRET_ACCESS_KEY}}.
# S3_FORCE_PATH_STYLE=1 only if the bucket's Credentials tab asks for path-style URLs.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# The capture worker's key to the worker API (/api/worker/*), sent as `Authorization: Bearer <token>`.
# At least 32 characters, e.g. `openssl rand -base64 32`; set the same value on the worker.
# Unset or shorter = the worker API answers 401 to everything.
WORKER_TOKEN=
# Worker only: origin of the web app. Hosted workers receive only this and WORKER_TOKEN.
INSPO_API_URL=http://localhost:3000
# Worker only: Chromium sandbox defaults to on. Leave unset when the host supports it.
# CHROMIUM_SANDBOX=off

# AI analysis: tags, description and layout summary (DE/EN) per reference, run inside the web app.
# Unset = analysis off and no analysis jobs are created; import, curation and text search keep working.
# Never give this key to the capture worker.
ANTHROPIC_API_KEY=
# The Claude model for the analysis; it must support structured output and effort. Default: claude-opus-5-5.
ANALYSIS_MODEL=

# Embeddings over title, notes, tags and AI description, computed by the web app's job runner.
# Any OpenAI-compatible /embeddings endpoint; default OpenRouter (key from openrouter.ai).
# They add semantic ranking to the gallery search, "Ähnliche Referenzen" and the MCP tools.
# Unset = no embedding jobs; search stays text-only and works as before. Never give this key to the capture worker.
EMBEDDINGS_API_KEY=
# The endpoint. Default: https://openrouter.ai/api/v1
EMBEDDINGS_BASE_URL=
# The embedding model (1024 dimensions). Default: voyageai/voyage-4.
# Vectors of another model are ignored until their references are embedded again.
EMBEDDINGS_MODEL=

# Adobe Fonts (fonts.adobe.com/account/tokens). The app keeps one preview kit per environment,
# "Inspo Vorschau (<host of INSPO_BASE_URL>)", and adds the Adobe families of every pairing to it,
# so the previews show the real typeface. Unset = Adobe families show a system font stand-in.
ADOBE_FONTS_API_TOKEN=
