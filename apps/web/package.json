{
  "name": "@m3-inspo/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev --port 3000",
    "build": "vite build",
    "start": "node --env-file-if-exists=../../.env .output/server/index.mjs",
    "typecheck": "pnpm i18n:compile && tsr generate && tsc -p tsconfig.json",
    "lint": "eslint",
    "backfill-palettes": "tsx --env-file-if-exists=../../.env scripts/backfill-palettes.ts",
    "i18n:compile": "paraglide-js compile --project ./project.inlang"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/s3-request-presigner": "^3.1137.0",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@m3-inspo/db": "workspace:*",
    "@m3-inspo/mcp": "workspace:*",
    "@m3-inspo/shared": "workspace:*",
    "@m3-inspo/taxonomy": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.57",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.47.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-message-format": "4.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.38",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "seroval": "^1.6.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.0"
  },
  "license": "MIT"
}
